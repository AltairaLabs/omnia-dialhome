{
  "$schema": "https://promptpack.org/schema/latest/promptpack.schema.json",
  "id": "dialhome-hosted-test",
  "name": "Dial-home hosted tools test pack",
  "version": "1.0.0",
  "description": "A pack whose prompt names a tool Omnia hosts and one tool of its own",
  "template_engine": {
    "version": "v1",
    "syntax": "{{variable}}"
  },
  "prompts": {
    "assistant": {
      "id": "assistant",
      "name": "Assistant",
      "version": "1.0.0",
      "system_template": "You are a helpful order assistant.",
      "tools": [
        "get_location",
        "lookup_order"
      ]
    }
  },
  "tools": {
    "get_location": {
      "name": "get_location",
      "description": "Get the user's current location",
      "parameters": {
        "type": "object",
        "properties": {
          "accuracy": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ]
          }
        }
      }
    }
  }
}
