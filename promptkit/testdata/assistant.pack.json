{
  "$schema": "https://promptpack.org/schema/latest/promptpack.schema.json",
  "id": "dialhome-test",
  "name": "Dial-home test pack",
  "version": "1.0.0",
  "description": "A minimal pack with one client tool, for the dial-home end-to-end tests",
  "template_engine": {
    "version": "v1",
    "syntax": "{{variable}}"
  },
  "prompts": {
    "assistant": {
      "id": "assistant",
      "name": "Assistant",
      "version": "1.0.0",
      "system_template": "You are a helpful assistant. Use get_location when asked where the user is.",
      "tools": ["get_location"]
    }
  },
  "tools": {
    "get_location": {
      "name": "get_location",
      "description": "Get the user's current location",
      "parameters": {
        "type": "object",
        "properties": {
          "accuracy": {"type": "string", "enum": ["high", "low"]}
        }
      }
    }
  }
}
